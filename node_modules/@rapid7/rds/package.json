{
  "name": "@rapid7/rds",
  "version": "3.3.0",
  "main": "./lib/cjs/index.js",
  "module": "./lib/esm/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "license": "MIT",
  "files": [
    "dist/**",
    "lib/**"
  ],
  "scripts": {
    "build": "npm run build:esm && npm run build:cjs",
    "build:esm": "tsc --project tsconfig.esm.json",
    "build:cjs": "tsc --project tsconfig.cjs.json",
    "build:quiet": "npm run build:esm -- --noEmit && npm run build:cjs -- --noEmit",
    "generate:tokens": "node ./scripts/converter.js ./scripts/export.json --generate-types",
    "dev": "tsc --watch",
    "lint": "eslint \"src/**/*.ts*\" && npm run build:quiet",
    "lint:fix": "eslint \"src/**/*.ts*\" --fix",
    "clean": "rm -rf node_modules && rm -rf dist && rm -rf lib",
    "test": "TZ=UTC vitest run",
    "testci": "TZ=UTC vitest run --coverage",
    "test:watch": "TZ=UTC vitest",
    "test:visual": "npx playwright test --config=playwright.config.ts",
    "test:visual:ui": "npx playwright test --ui --config=playwright.config.ts"
  },
  "devDependencies": {
    "@fontsource/rubik": "5.2.8",
    "@babel/cli": "7.12.10",
    "@babel/core": "7.12.10",
    "@babel/preset-env": "7.22.7",
    "@babel/preset-react": "7.12.10",
    "@babel/preset-typescript": "7.23.3",
    "@mui/x-data-grid-generator": "7.29.6",
    "@rapid7/icons-material": "1.0.5",
    "@types/css-mediaquery": "0.1.4",
    "archiver": "7.0.1",
    "babel-eslint": "10.1.0",
    "babel-loader": "8.2.2",
    "babel-plugin-ramda": "2.0.0",
    "babel-runtime": "6.26.0",
    "css-mediaquery": "0.1.2",
    "dayjs": "1.11.13",
    "eslint": "8.15.0",
    "eslint-config-internal": "0.0.4",
    "rimraf": "4.4.1",
    "typescript": "5.4.5",
    "unzipper": "0.12.2"
  },
  "dependencies": {
    "@emotion/react": "11.11.1",
    "@emotion/styled": "11.11.0",
    "@mui/icons-material": "6.4.3",
    "@mui/material": "6.4.3",
    "@mui/x-data-grid-premium": "7.29.6",
    "@mui/x-date-pickers-pro": "7.26.0",
    "@mui/x-license": "7.26.0"
  },
  "peerDependencies": {
    "dayjs": "1.11.13",
    "react": "^16.14.0 || ^17.0.1 || ^18.0.0",
    "react-dom": "^16.14.0 || ^17.0.1 || ^18.0.0",
    "@rapid7/icons-material": "^1.0.5",
    "@fontsource/rubik": "^5.0.0"
  },
  "publishConfig": {
    "registry": "https://artifacts.corp.rapid7.com/nexus/content/repositories/npm-internal/"
  },
  "overrides": {
    "rimraf": "4.4.1",
    "unzipper": "0.12.2",
    "@mui/x-data-grid-premium": {
      "exceljs": {
        "archiver": "$archiver",
        "unzipper": {
          ".": "$unzipper",
          "fstream": {
            ".": "1.0.12",
            "rimraf": "$rimraf"
          }
        }
      }
    }
  }
}
