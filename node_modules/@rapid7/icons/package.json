{
  "name": "@rapid7/icons",
  "version": "1.10.0",
  "main": "./lib/cjs/index.js",
  "module": "./lib/esm/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**",
    "lib/**"
  ],
  "scripts": {
    "build": "ts-node --compilerOptions '{\"module\":\"NodeNext\",\"moduleResolution\":\"NodeNext\"}' src/scripts/index.ts && npm run build:esm && npm run build:cjs",
    "build:esm": "tsc --project tsconfig.esm.json",
    "build:cjs": "tsc --project tsconfig.cjs.json",
    "clean": "rm -rf node_modules && rm -rf dist && rm -rf lib"
  },
  "devDependencies": {
    "@hugeicons/react": "0.6.2",
    "@mui/icons-material": "6.4.3",
    "@mui/material": "6.4.3",
    "@babel/core": "7.26.7",
    "@babel/preset-typescript": "7.26.0",
    "@rapid7/rapid7-icon-font": "8.18.5",
    "svgo": "4.0.0",
    "ts-node": "10.9.2",
    "typescript": "5.4.5",
    "xast-util-from-xml": "4.0.0",
    "xast-util-to-xml": "4.0.0"
  },
  "peerDependencies": {
    "@rapid7/rds-theme-metadata-provider": "^1.1.0",
    "react": "^16.14.0 || ^17.0.1 || ^18.0.0",
    "react-dom": "^16.14.0 || ^17.0.1 || ^18.0.0"
  },
  "publishConfig": {
    "registry": "https://artifacts.corp.rapid7.com/nexus/content/repositories/npm-internal/"
  }
}
