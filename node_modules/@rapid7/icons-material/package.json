{
  "name": "@rapid7/icons-material",
  "version": "1.0.5",
  "main": "./lib/cjs/index.js",
  "module": "./lib/esm/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**",
    "lib/**"
  ],
  "sideEffects": false,
  "license": "MIT",
  "scripts": {
    "build": "bash src/components/icon/scripts/generateIcons.sh && npm run build:esm && npm run build:cjs",
    "build:esm": "tsc --project tsconfig.esm.json",
    "build:cjs": "tsc --project tsconfig.cjs.json",
    "clean": "rm -rf node_modules && rm -rf dist && rm -rf lib"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rapid7/Rapid7-UI-Foundations.git"
  },
  "devDependencies": {
    "@rapid7/rapid7-icon-font": "8.18.5",
    "@rapid7/rapid7-web": "3.6.2",
    "dotenv": "16.4.5",
    "ts-node": "10.9.1",
    "typescript": "5.4.5",
    "styled-components": "5.3.3"
  },
  "peerDependencies": {
    "@mui/material": "^6.3.1",
    "react": "^16.14.0 || ^17.0.1 || ^18.0.0",
    "react-dom": "^16.14.0 || ^17.0.1 || ^18.0.0"
  }
}
